{
  "name": "auradesign-studio",
  "version": "1.1.0",
  "description": "Premium dark-themed agency & portfolio website template with interactive canvas effects, SPA navigation, an analytics dashboard, and dual static / Node-Express deployment.",
  "keywords": [
    "template",
    "agency",
    "portfolio",
    "tailwind",
    "dark-theme",
    "express",
    "spa",
    "landing-page"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Your Name <you@example.com>",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.19"
  }
}
