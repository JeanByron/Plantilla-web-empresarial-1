# AuraDesign Studio — environment variables (full-stack mode)
# Only used when running the Node server. Three ways to apply these values:
#   1. Inline (works everywhere):   PORT=3100 ADMIN_KEY=secret npm start
#   2. .env file (Node 20+):        copy this file to ".env", then: npm run start:env
#   3. Your host's dashboard env vars (Render, Railway, Fly, etc.).
# Note: plain `npm start` does NOT read a .env file — use option 1, 2, or 3.

# Port the Express server listens on.
PORT=3000

# Admin key that protects GET /api/inquiries.
# - If set, the endpoint requires the header "x-admin-key: <value>" (or ?key=<value>).
# - If left unset, the endpoint is reachable only from localhost (loopback),
#   so your visitors' contact data is never exposed publicly by default.
ADMIN_KEY=
